{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","institution","campus","sources","buildings","entrances","pathNodes","pathEdges"],
  "properties":{
    "schemaVersion":{"const":1},"institution":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},
    "campus":{"type":"object","additionalProperties":false,"required":["id","name","bounds"],"properties":{"id":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"bounds":{"anyOf":[{"type":"null"},{"type":"array","items":{"$ref":"#/$defs/coordinate"},"minItems":2,"maxItems":2}]}}},
    "sources":{"type":"array","items":{"$ref":"#/$defs/source"}},
    "buildings":{"type":"array","items":{"$ref":"#/$defs/building"}},
    "entrances":{"type":"array","items":{"$ref":"#/$defs/entrance"}},
    "pathNodes":{"type":"array","items":{"$ref":"#/$defs/node"}},
    "pathEdges":{"type":"array","items":{"$ref":"#/$defs/edge"}}
  },
  "$defs":{
    "coordinate":{"type":"array","items":[{"type":"number","minimum":-180,"maximum":180},{"type":"number","minimum":-90,"maximum":90}],"additionalItems":false},
    "source":{"type":"object","additionalProperties":false,"required":["id","title","url","retrievedAt","licenseOrTerms","redistribution","transformation"],"properties":{"id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"url":{"type":"string","format":"uri"},"retrievedAt":{"type":"string","format":"date"},"licenseOrTerms":{"type":"string","minLength":1},"redistribution":{"enum":["permitted","unclear","prohibited"]},"transformation":{"type":"string","minLength":1},"attribution":{"type":"string"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["sourceId","nativeId","verification"],"properties":{"sourceId":{"type":"string","minLength":1},"nativeId":{"type":["string","null"]},"verification":{"enum":["source-backed","field-reviewed","inferred"]}}},
    "building":{"type":"object","additionalProperties":false,"required":["id","name","nativeCodes","aliases","geometry","provenance"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"name":{"type":"string","minLength":1},"nativeCodes":{"type":"array","items":{"type":"string","minLength":1}},"aliases":{"type":"array","items":{"type":"string","minLength":1}},"category":{"enum":["academic","residence","facility"]},"geometry":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["type","coordinates"],"properties":{"type":{"enum":["Polygon","MultiPolygon"]},"coordinates":{"type":"array","minItems":1}}}]},"provenance":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/provenance"}}}},
    "entrance":{"type":"object","additionalProperties":false,"required":["id","buildingId","coordinate","pathNodeId","access","provenance"],"properties":{"id":{"type":"string","minLength":1},"buildingId":{"type":"string","minLength":1},"coordinate":{"$ref":"#/$defs/coordinate"},"pathNodeId":{"type":"string","minLength":1},"access":{"enum":["public","restricted","unknown"]},"provenance":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/provenance"}}}},
    "node":{"type":"object","additionalProperties":false,"required":["id","coordinate","provenance"],"properties":{"id":{"type":"string","minLength":1},"coordinate":{"$ref":"#/$defs/coordinate"},"provenance":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/provenance"}}}},
    "edge":{"type":"object","additionalProperties":false,"required":["id","from","to","mode","provenance"],"properties":{"id":{"type":"string","minLength":1},"from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1},"mode":{"enum":["outdoor-walk","tunnel-walk"]},"provenance":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/provenance"}}}}
  }
}
